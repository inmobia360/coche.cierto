  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.3",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  }
