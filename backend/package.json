{
  "name": "cochecierto-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API del MVP de diagnóstico y captación de CocheCierto",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js",
    "check:purchase-flow": "node scripts/check-purchase-flow.mjs",
    "check:crm-lifecycle": "node scripts/check-crm-lifecycle.mjs",
