{
  "manifest_version": 3,
  "name": "SUBASTA — Auto1 Risk Lens",
  "version": "0.1.0",
  "description": "Analiza coste, riesgo y rentabilidad orientativa de vehículos de subasta.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.auto1.com/*"],
  "action": { "default_title": "SUBASTA", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://www.auto1.com/es/app/merchant/*"],
    "js": ["src/risk-engine.js", "src/content.js"],
    "css": ["src/content.css"],
    "run_at": "document_idle"
  }]
}
