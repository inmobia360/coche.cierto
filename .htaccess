DirectoryIndex index.html
Options -Indexes

# SEO: unificar el dominio www bajo el principal con 301 permanente.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.cochecierto\.com$ [NC]
RewriteRule ^(.*)$ https://cochecierto.com/$1 [R=301,L]

# Metodología se integró en Cómo funciona; conservar enlaces antiguos sin
# mantener una segunda sección indexable.
Redirect 301 /metodologia/ /como-funciona/
Redirect 301 /informe-demo.html /demo/
Redirect 301 /demo/informe.html /demo/

# Compresión GZIP y cabeceras de caché
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<FilesMatch "^(popup|test-autouncle)\.html$">
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</FilesMatch>
