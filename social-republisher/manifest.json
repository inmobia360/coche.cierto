{
  "manifest_version": 3,
  "name": "CocheCierto · Social Repost asistido",
  "version": "0.1.0",
  "description": "Prepara republicaciones de CocheCierto con UTMs y confirmación humana.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs"
  ],
  "action": {
    "default_title": "Preparar republicación",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}



